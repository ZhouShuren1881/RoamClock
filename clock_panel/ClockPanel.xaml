<UserControl x:Class="RoamClock.Components.ClockPanel"
             x:Name="Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="154" d:DesignHeight="48"
             FontFamily="Segoe UI" Foreground="White" Background="Transparent"
             MinWidth="50" MinHeight="40" UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="{Binding Display.AccessibleText, ElementName=Panel}">
    <Border Background="{Binding Background, ElementName=Panel}" Padding="10,3">
        <Grid DataContext="{Binding Display, ElementName=Panel}" VerticalAlignment="Center">
            <Grid.ToolTip>
                <ToolTip MaxWidth="380"><TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap"/></ToolTip>
            </Grid.ToolTip>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Time}" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Right" MinWidth="100" TextAlignment="Right"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <StackPanel Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Visibility="{Binding WeatherVisibility}">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Canvas Width="26" Height="26">
                        <Path Data="{Binding WeatherPath}" Stroke="{Binding Foreground, ElementName=Panel}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding Temperature}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <Ellipse Width="4" Height="4" Margin="4,0,0,0" Fill="#E6B96A"
                         Visibility="{Binding StaleVisibility}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Date}" FontSize="11" Opacity="0.78" VerticalAlignment="Center"
                       HorizontalAlignment="Right" MinWidth="100" TextAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
