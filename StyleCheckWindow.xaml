<Window x:Class="RoamClock.StyleCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panel="clr-namespace:RoamClock.Components"
        Title="Style Check - RoamClock" Icon="/RoamClock;component/assets/app.ico" Width="920" Height="700" MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <TextBlock Text="Style Check" FontSize="26" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="Clock panel · 时钟、天气与任务栏尺寸预览" Margin="0,6,0,24" Foreground="#667085"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="显示时区" Margin="0,0,0,6"/><ComboBox x:Name="ZonePicker" SelectionChanged="SettingsChanged"/></StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="天气城市（独立于时区）" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="应用城市" Click="ApplyCity"/>
                        <TextBox x:Name="CityInput" Text="Singapore" Padding="8,6" KeyDown="CityKeyDown"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,16" VerticalAlignment="Center">
                <CheckBox x:Name="SecondsToggle" Content="显示秒" VerticalAlignment="Center" Margin="0,0,20,0"
                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                <CheckBox x:Name="WeatherToggle" Content="显示天气" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"
                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ScalePicker" Width="90" SelectionChanged="SettingsChanged" Margin="0,0,20,0">
                    <ComboBoxItem Content="100%" Tag="1" IsSelected="True"/>
                    <ComboBoxItem Content="125%" Tag="1.25"/>
                    <ComboBoxItem Content="150%" Tag="1.5"/>
                    <ComboBoxItem Content="200%" Tag="2"/>
                </ComboBox>
                <TextBlock Text="天气预览" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WeatherMode" Width="136" SelectionChanged="SettingsChanged">
                    <ComboBoxItem Content="实时天气" Tag="live" IsSelected="True"/>
                    <ComboBoxItem Content="晴 · 示例" Tag="sun"/>
                    <ComboBoxItem Content="雨 · 示例" Tag="rain"/>
                    <ComboBoxItem Content="雪 · 示例" Tag="snow"/>
                    <ComboBoxItem Content="过期天气 · 示例" Tag="stale"/>
                    <ComboBoxItem Content="加载中 · 示例" Tag="loading"/>
                    <ComboBoxItem Content="请求失败 · 示例" Tag="error"/>
                </ComboBox>
            </WrapPanel>
            <TextBlock Text="深色任务栏" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,0,8"/>
            <Border Background="#202329" BorderBrush="#363A43" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid MinHeight="96">
                    <TextBlock Text="任务栏预览" Foreground="#8A909C" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#434954" BorderThickness="1">
                        <panel:ClockPanel x:Name="DarkPanel" Width="154" Height="48" Foreground="#F7F8FA"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="浅色任务栏" FontWeight="SemiBold" Foreground="#475467" Margin="0,20,0,8"/>
            <Border Background="#FCFCFD" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid MinHeight="96">
                    <TextBlock Text="任务栏预览" Foreground="#98A2B3" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#D0D5DD" BorderThickness="1">
                        <panel:ClockPanel x:Name="LightPanel" Width="154" Height="48" Foreground="#172033"/>
                    </Border>
                </Grid>
            </Border>
            <DockPanel Margin="0,20,0,8">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新天气" Click="RefreshWeather"/>
                <TextBlock x:Name="StatusText" Text="等待天气数据…" Foreground="#475467" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="面板原始尺寸 154 × 48 DIP；悬停可查看天气详情。天气来源：Open-Meteo。" Foreground="#667085" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</Window>
